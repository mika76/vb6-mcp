# .NET
bin/
obj/
*.user
.vs/

# Build output
build/
publish/

# VB6 build artifacts and per-user files
*.exe
*.dll
*.ocx
*.exp
*.lib
*.oca
*.vbw
*.log
# ...except the committed binary-compatibility reference for the add-in
!addin/compat/*.dll

# Local config
dev.json
.claude/settings.local.json

# Spike logs
spikes/**/server.log

# Spike outputs
spikes/**/out/

# Per-user VB6 / SourceSafe files
MSSCCPRJ.SCC
*.scc

# Scratch VB6 project used during spikes (contains user-specific SCC files)
tests/fixtures/scratch/

# written by VB6 itself (e.g. when projects are closed); never part of the repo
/*.vbg

# compiled fixture programs (exe_run tests)
tests/fixtures/**/*.exe

# fixture build outputs (build_make tests)
tests/fixtures/**/*.dll
tests/fixtures/**/*.lib
tests/fixtures/**/*.exp
tests/fixtures/**/*.oca

# Packages (scripts\package.ps1)
dist/

# Benchmark runs: transcripts and raw results (the report goes to docs/benchmarks)
bench/results/
